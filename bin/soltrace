#!/usr/bin/env python3
import sys
import os

# Auto-detect project virtual environment and ensure its packages are available
package_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
workspace_root = os.path.dirname(os.path.dirname(package_root))

candidate_roots = [
    workspace_root,
    package_root,
    os.path.dirname(package_root)
]

for root in candidate_roots:
    venv_lib = os.path.join(root, ".venv", "lib")
    if os.path.exists(venv_lib):
        for entry in os.listdir(venv_lib):
            sp = os.path.join(venv_lib, entry, "site-packages")
            if os.path.exists(sp) and sp not in sys.path:
                sys.path.insert(0, sp)

if package_root not in sys.path:
    sys.path.insert(0, package_root)

from soltrace.cli import main

if __name__ == "__main__":
    main()
