#!/usr/bin/env python3
import sys
import os

# Auto-detect project virtual environment if not already active
package_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
workspace_root = os.path.dirname(os.path.dirname(package_root))
venv_python = os.path.join(workspace_root, ".venv", "bin", "python3")

if os.path.exists(venv_python) and sys.executable != venv_python:
    os.execv(venv_python, [venv_python] + sys.argv)

if package_root not in sys.path:
    sys.path.insert(0, package_root)

from soltrace.cli import main

if __name__ == "__main__":
    main()
