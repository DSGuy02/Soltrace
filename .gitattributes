# Enforce LF endings across all platforms
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Executable scripts
bin/* text eol=lf
demo_*.sh text eol=lf

# Binary files
*.db binary
*.png binary
*.jpg binary
*.jpeg binary
*.pptx binary
